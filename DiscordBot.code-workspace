{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			".vs": true,
			"*\\obj": true,
			"*\\*.user": true
		},
		"files.watcherExclude": {
			".vs": true,
			"*\\obj": true,
			"*\\*.user": true
		},
		"search.exclude": {
			".vs": true,
			"*\\obj": true,
			"*\\*.user": true
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build",
				"command": "dotnet build discordbot.sln --configuration Debug",
				"type": "shell",
				"args": [],
				"group": "build",
				"problemMatcher": "$msCompile"
			},
			{
				"label": "test",
				"command": "dotnet test discordbot.sln --configuration Debug",
				"type": "shell",
				"args": [],
				"group": "test",
				"problemMatcher": "$msCompile"
			},
			{
				"label": "format:check",
				"command": "dotnet format discordbot.sln --verify-no-changes --verbosity minimal",
				"type": "shell",
				"args": [],
				"problemMatcher": "$msCompile"
			}
		]
	},
	"launch": {
		// Use IntelliSense to learn about possible attributes.
		// Hover to view descriptions of existing attributes.
		// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
		"version": "0.2.0",
		"configurations": [
			{
				"name": ".NET Core Launch (console)",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build",
				"program": "${workspaceFolder}/discordbot/bin/Debug/net10.0/discordbot.dll",
				"args": [],
				"cwd": "${workspaceFolder}",
				"stopAtEntry": false,
				"console": "integratedTerminal"
			}
		]
	}
}
